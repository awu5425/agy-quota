{
  "name": "agy-quota",
  "version": "1.3.3",
  "description": "Antigravity 2.x quota suite & /agy-quota Agent Skill: dual-mode top-right semi-ring HUD (standalone or Context Meter companion), optional native right sidecar, per-model 90m burn trend, EN/ZH i18n, auto theme sync, GitHub self-update, and CLI/Web tools.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "agy-quota": "./cli.mjs"
  },
  "scripts": {
    "start": "node cli.mjs",
    "cli": "node cli.mjs",
    "watch": "node cli.mjs --watch",
    "models": "node cli.mjs --models",
    "dump": "node cli.mjs --json",
    "standalone": "node cli.mjs --standalone --port 4318",
    "top-right": "node cli.mjs --top-right",
    "overlay": "node cli.mjs --top-right",
    "ensure": "node cli.mjs --ensure",
    "overlay-status": "node cli.mjs --overlay-status",
    "uninstall-overlay": "node cli.mjs --uninstall-overlay",
    "skill": "node cli.mjs --skill",
    "skill-status": "node cli.mjs --skill-status",
    "uninstall-skill": "node cli.mjs --uninstall-skill",
    "sidecar": "node cli.mjs --sidecar",
    "uninstall-sidecar": "node cli.mjs --uninstall-sidecar",
    "install-plugin": "node install.mjs",
    "uninstall-plugin": "node install.mjs --uninstall",
    "check-update": "node cli.mjs --check-update",
    "update": "node cli.mjs --update",
    "test": "node --test test/regression.test.mjs"
  },
  "keywords": [
    "antigravity",
    "agy",
    "quota",
    "agent-skills",
    "skill",
    "sidecar",
    "semi-ring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/awu5425/agy-quota.git"
  },
  "homepage": "https://github.com/awu5425/agy-quota"
}
